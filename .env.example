# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real tokens.

# ── Telegram (free) ──────────────────────────────────────────────
# 1. Message @BotFather on Telegram, run /newbot, copy the token it gives you.
# 2. Message your new bot once, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your numeric chat id in the response.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Apollo.io (free tier, optional) ──────────────────────────────
# Used only to auto-discover Priority C/D contacts (engineering leads,
# recruiters) at a company. Viewing name/title/company/LinkedIn URL is
# free on Apollo's free tier — this project never reveals emails or
# phone numbers, which is the only thing that costs credits.
# Get a key at: https://app.apollo.io/#/settings/integrations/api
# Leave blank to skip Apollo entirely and rely only on known_connections.json.
APOLLO_API_KEY=
