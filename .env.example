# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real tokens.

# ── Telegram (free) ──────────────────────────────────────────────
# 1. Message @BotFather on Telegram, run /newbot, copy the token it gives you.
# 2. Message your new bot once, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your numeric chat id in the response.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── JSearch via RapidAPI (free tier: 200 requests/month) ─────────
# 1. Create a RapidAPI account: https://rapidapi.com
# 2. Go to https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch and
#    click "Subscribe" on the free "Basic" plan (required even though
#    it's free — a RapidAPI key alone is NOT enough until you subscribe
#    to this specific API).
# 3. Copy your RapidAPI key from the endpoint's code snippet.
RAPIDAPI_KEY=

# ── Apollo.io (free tier, optional) ──────────────────────────────
# Used only to auto-discover Priority C/D contacts (engineering leads,
# recruiters) at a company. NOTE: as of this writing, Apollo's search
# API endpoints return "API_INACCESSIBLE" on a true Free plan — API
# access requires a paid plan. Leave this blank to skip Apollo entirely
# and rely only on your LinkedIn connections CSV (Priority A); the code
# will pick it up automatically if you upgrade later.
# Get a key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

# ── LinkedIn Connections CSV (free, manual export) ────────────────
# Only needed if you keep the export somewhere other than
# ./Connections.csv (the default).
# LINKEDIN_CSV_PATH=Connections.csv
